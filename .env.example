# ======================================================================
# XESXOR Bot — environment configuration template
# Copy to `.env` and fill in.  NEVER commit the real .env file.
# The bot is 100% free: no payment keys required.
# ======================================================================

# --- Platforms (configure at least ONE) --------------------------------
# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Telegram bot token from @BotFather (see README for the full walkthrough)
TELEGRAM_BOT_TOKEN=

# --- AI (XESXOR AI assistant, quizzes, news briefings) -----------------
# Google AI Studio API key (https://aistudio.google.com/apikey)
AI_API_KEY=

# --- Runtime -----------------------------------------------------------
# SQLite database file (created automatically)
DATABASE_PATH=bot_database.db
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Keep-alive HTTP port (used by the free-tier keep-alive server)
PORT=10000
# Interface the keep-alive server binds to. 127.0.0.1 keeps the status
# endpoint private (recommended on a VPS/EC2). Use 0.0.0.0 ONLY on
# free-tier hosts (Render etc.) or inside a container that must be
# reachable externally.
KEEP_ALIVE_HOST=127.0.0.1
# Self-ping keep-alive server for free-tier hosts (Render etc.)
KEEP_ALIVE_ENABLED=true

# --- Discord behaviour -------------------------------------------------
# When true, the bot builds its full server layout (roles, channels,
# permission lockdown) in EVERY guild it joins.  Keep false for public
# deployments so foreign servers are never modified.  The existing
# XESXOR server keeps working either way.
DISCORD_AUTO_SETUP=false

# --- Telegram behaviour -----------------------------------------------
# Comma-separated Telegram user ids that always count as administrators
# (bot owners).  Example: 123456789,987654321
TELEGRAM_ADMIN_IDS=
# Comma-separated chat ids that receive the AI news briefings.
# Add the bot to a channel/group, then read the id from @getidsbot.
TELEGRAM_NEWS_CHAT_IDS=
# Group chat id that receives support tickets and suggestions (optional).
TELEGRAM_STAFF_CHAT_ID=
# When true, new group members are muted until they press Verify or /verify.
# Requires the bot to have "Restrict members" permission.  Default false.
TELEGRAM_REQUIRE_VERIFY=false

# --- News schedule -----------------------------------------------------
# Hours between automated news briefings (Discord news channels and any
# configured Telegram news chats).
NEWS_INTERVAL_HOURS=8
