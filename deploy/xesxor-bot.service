[Unit]
Description=XESXOR Bot (Discord + Telegram, 24/7)
Documentation=https://github.com/d3v0o0nu11/XESXOR_BOT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/xesxor-bot
ExecStart=/opt/xesxor-bot/venv/bin/python main.py
Restart=always
RestartSec=5
MemoryMax=800M
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
