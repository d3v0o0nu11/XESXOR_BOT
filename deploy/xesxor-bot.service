[Unit]
Description=XESXOR Bot (Discord + Telegram, 24/7)
Documentation=https://github.com/d3v0o0nu11/XESXOR_BOT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/xesxor-bot
ExecStart=/opt/xesxor-bot/venv/bin/python main.py
Restart=always
RestartSec=5
MemoryMax=800M
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# --- Sandboxing / least privilege -------------------------------------
# The bot only needs its own directory plus network access.  These limits
# prevent a compromised dependency (or a bad AI answer) from touching the
# rest of the host.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xesxor-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
